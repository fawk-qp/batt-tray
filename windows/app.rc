#include <winver.h>

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,3,0
 PRODUCTVERSION 1,2,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BattTray Open Source"
            VALUE "FileDescription", "Wireless Peripherals Battery Tray Indicator"
            VALUE "FileVersion", "1.2.3.0"
            VALUE "InternalName", "batt-tray"
            VALUE "OriginalFilename", "batt-tray.exe"
            VALUE "ProductName", "BattTray"
            VALUE "ProductVersion", "1.2.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END