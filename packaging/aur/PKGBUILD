pkgname=batt-tray-bin
pkgver=1.4.0
pkgrel=1
pkgdesc="Wireless peripherals battery tray indicator"
arch=('x86_64')
url="https://github.com/fawk-qp/batt-tray"
license=('MIT')
depends=('dbus')
provides=('batt-tray')
conflicts=('batt-tray')
source=(
    "batt-tray-${pkgver}-x86_64::https://github.com/fawk-qp/batt-tray/releases/download/v${pkgver}/batt-tray-linux-rust"
    "batt-tray-${pkgver}.service::https://raw.githubusercontent.com/fawk-qp/batt-tray/v${pkgver}/linux/batt-tray.service"
)
sha256sums=('4c616e2cd500caf31e5abddb2b6bea35fc9942cba7f58a16441e036376d420f5' 'eeed0cf79a842d101375074f2a1bfb66b75322d2c89d9de4b20708d77b3a3716')

package() {
    install -Dm755 "${srcdir}/batt-tray-${pkgver}-x86_64" "${pkgdir}/usr/bin/batt-tray"
    sed 's|ExecStart=%h/.local/bin/batt-tray|ExecStart=/usr/bin/batt-tray|' \
        "${srcdir}/batt-tray-${pkgver}.service" > "${srcdir}/batt-tray.service.out"
    install -Dm644 "${srcdir}/batt-tray.service.out" "${pkgdir}/usr/lib/systemd/user/batt-tray.service"
}
